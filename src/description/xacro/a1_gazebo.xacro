<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="a1_leg_gazebo" params="name">
        <gazebo reference="${name}_hip">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <material>Gazebo/DarkGrey</material>
        </gazebo>
        <gazebo reference="${name}_thigh">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <self_collide>true</self_collide>
            <material>Gazebo/DarkGrey</material>
        </gazebo>
        <gazebo reference="${name}_calf">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <self_collide>true</self_collide>
            <material>Gazebo/DarkGrey</material>
        </gazebo>
        <gazebo reference="${name}_foot">
            <mu1>0.6</mu1>
            <mu2>0.6</mu2>
            <kp>1000000.0</kp>
            <kd>1.0</kd>
            <material>Gazebo/DarkGrey</material>
        </gazebo>
    </xacro:macro>

    <xacro:macro name="a1_gazebo">
        <gazebo reference="trunk">
            <material>Gazebo/Orange</material>
        </gazebo>

        <gazebo reference="imu_link">
            <gravity>true</gravity>
            <sensor name="trunk_imu" type="imu">
                <always_on>true</always_on>
                <update_rate>1000</update_rate>
                <visualize>false</visualize>
                <plugin name="trunk_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
                    <ros>
                        <namespace>/</namespace>
                        <remapping>~/out:=imu</remapping>
                    </ros>
                    <frame_name>imu_link</frame_name>
                    <initial_orientation_as_reference>false</initial_orientation_as_reference>
                </plugin>
            </sensor>
        </gazebo>

        <xacro:a1_leg_gazebo name="FR"/>
        <xacro:a1_leg_gazebo name="FL"/>
        <xacro:a1_leg_gazebo name="RR"/>
        <xacro:a1_leg_gazebo name="RL"/>

        <gazebo>
            <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
                <parameters>$(find a1_controller)/config/a1_controllers.yaml</parameters>
            </plugin>
        </gazebo>
    </xacro:macro>
</robot>
