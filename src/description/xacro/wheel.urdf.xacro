<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find description)/xacro/common_inertia.xacro"/>
    <xacro:macro name="wheel_xacro" params="wheel_name xyz radius:=0.055 width:=0.045 mass:=0.18">
        <link name="${wheel_name}_link">
            <!-- 部件的外观描述-->
            <visual>
                <!-- 沿着自己几何中心的偏移和旋转量-->
                <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/>
                <!-- 几何形状-->
                <geometry>
                    <cylinder radius="${radius}" length="${width}"/>
                </geometry>
                <!-- 材质颜色-->
                <material name='yellow'>
                    <color rgba="1.0 1.0 0.0 0.8"/>
                </material>
            </visual>
            <collision>
                <!-- 沿着自己几何中心的偏移和旋转量-->
                <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/>
                <!-- 几何形状-->
                <geometry>
                    <cylinder radius="${radius}" length="${width}"/>
                </geometry>
                <!-- 材质颜色-->
                <material name='yellow'>
                    <color rgba="1.0 1.0 0.0 0.8"/>
                </material>
            </collision>

            <xacro:cylinder_inertia m="${mass}" r="${radius}" h="${width}"/>
        </link>
        
        <joint name="${wheel_name}_joint" type="continuous">
            <origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
            <parent link="base_link"/>
            <child link="${wheel_name}_link"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>

        <gazebo reference="${wheel_name}_link">
            <fdir1>1 0 0</fdir1>
            <mu1>8.0</mu1>
            <mu2>0.35</mu2>
            <kp>100000.0</kp>
            <kd>1.0</kd>
            <maxVel>0.1</maxVel>
            <minDepth>0.001</minDepth>
        </gazebo>
    </xacro:macro>
</robot>
