<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="a1_controlled_joint" params="name initial_position">
        <joint name="${name}">
            <command_interface name="effort">
                <param name="min">-33.5</param>
                <param name="max">33.5</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">${initial_position}</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="a1_ros2_control">
        <ros2_control name="A1GazeboSystem" type="system">
            <hardware>
                <plugin>gazebo_ros2_control/GazeboSystem</plugin>
            </hardware>
            <xacro:a1_controlled_joint name="FR_hip_joint" initial_position="-0.35"/>
            <xacro:a1_controlled_joint name="FR_thigh_joint" initial_position="1.36"/>
            <xacro:a1_controlled_joint name="FR_calf_joint" initial_position="-2.65"/>
            <xacro:a1_controlled_joint name="FL_hip_joint" initial_position="0.35"/>
            <xacro:a1_controlled_joint name="FL_thigh_joint" initial_position="1.36"/>
            <xacro:a1_controlled_joint name="FL_calf_joint" initial_position="-2.65"/>
            <xacro:a1_controlled_joint name="RR_hip_joint" initial_position="-0.50"/>
            <xacro:a1_controlled_joint name="RR_thigh_joint" initial_position="1.36"/>
            <xacro:a1_controlled_joint name="RR_calf_joint" initial_position="-2.65"/>
            <xacro:a1_controlled_joint name="RL_hip_joint" initial_position="0.50"/>
            <xacro:a1_controlled_joint name="RL_thigh_joint" initial_position="1.36"/>
            <xacro:a1_controlled_joint name="RL_calf_joint" initial_position="-2.65"/>
        </ros2_control>
    </xacro:macro>
</robot>
