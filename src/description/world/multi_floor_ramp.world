<?xml version='1.0'?>
<!--
  Three-level parking garage for the project robot.

  Deck elevations: 0.0 m / 2.4 m / 4.8 m (2.2 m clear height).
  East side: 3.8 m wide vehicle ramps (about 11.3 degrees).
  West side: 2.2 m wide stairs with 0.08 m risers and 0.267 m treads.
  Every ramp, stair, landing and exposed deck edge has collision-enabled guards.
-->
<sdf version='1.7'>
  <world name='three_level_parking_garage'>
    <light name='sun' type='directional'>
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.85 0.85 0.82 1</diffuse>
      <specular>0.18 0.18 0.18 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.45 0.25 -0.86</direction>
    </light>

    <!-- Ceiling lights keep both covered decks readable with shadows enabled. -->
    <light name='level_1_light_west' type='point'>
      <pose>-5 0 2.06 0 0 0</pose><cast_shadows>false</cast_shadows>
      <diffuse>0.95 0.94 0.84 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>12</range><constant>0.7</constant><linear>0.08</linear><quadratic>0.02</quadratic></attenuation>
    </light>
    <light name='level_1_light_east' type='point'>
      <pose>5 0 2.06 0 0 0</pose><cast_shadows>false</cast_shadows>
      <diffuse>0.95 0.94 0.84 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>12</range><constant>0.7</constant><linear>0.08</linear><quadratic>0.02</quadratic></attenuation>
    </light>
    <light name='level_2_light_west' type='point'>
      <pose>-5 0 4.46 0 0 0</pose><cast_shadows>false</cast_shadows>
      <diffuse>0.92 0.95 1 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>12</range><constant>0.7</constant><linear>0.08</linear><quadratic>0.02</quadratic></attenuation>
    </light>
    <light name='level_2_light_east' type='point'>
      <pose>5 0 4.46 0 0 0</pose><cast_shadows>false</cast_shadows>
      <diffuse>0.92 0.95 1 1</diffuse><specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>12</range><constant>0.7</constant><linear>0.08</linear><quadratic>0.02</quadratic></attenuation>
    </light>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <physics type='ode'>
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>25</iters><sor>1.0</sor></solver>
        <constraints>
          <cfm>0</cfm><erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <plugin name='gazebo_ros_state' filename='libgazebo_ros_state.so'>
      <ros><namespace>/</namespace></ros>
      <update_rate>10.0</update_rate>
    </plugin>
    <scene>
      <ambient>0.42 0.44 0.47 1</ambient>
      <background>0.72 0.77 0.82 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Ground is deliberately below the deck so it cannot create duplicate contacts. -->
    <model name='site_ground'>
      <static>true</static>
      <link name='ground'>
        <pose>0 0 -0.27 0 0 0</pose>
        <collision name='collision'><geometry><box><size>50 40 0.10</size></box></geometry></collision>
        <visual name='visual'>
          <geometry><box><size>50 40 0.10</size></box></geometry>
          <material><ambient>0.20 0.22 0.20 1</ambient><diffuse>0.25 0.27 0.24 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name='three_level_parking_structure'>
      <static>true</static>

      <!-- Three vertically aligned 20 m x 14 m parking decks. -->
      <link name='parking_decks'>
        <collision name='floor_1_collision'>
          <pose>0 0 -0.10 0 0 0</pose><geometry><box><size>20 14 0.20</size></box></geometry>
          <surface><friction><ode><mu>20</mu><mu2>20</mu2></ode></friction></surface>
        </collision>
        <visual name='floor_1_visual'>
          <pose>0 0 -0.10 0 0 0</pose><geometry><box><size>20 14 0.20</size></box></geometry>
          <material><ambient>0.36 0.38 0.40 1</ambient><diffuse>0.42 0.44 0.46 1</diffuse></material>
        </visual>
        <collision name='floor_2_collision'>
          <pose>0 0 2.30 0 0 0</pose><geometry><box><size>20 14 0.20</size></box></geometry>
          <surface><friction><ode><mu>20</mu><mu2>20</mu2></ode></friction></surface>
        </collision>
        <visual name='floor_2_visual'>
          <pose>0 0 2.30 0 0 0</pose><geometry><box><size>20 14 0.20</size></box></geometry>
          <material><ambient>0.40 0.42 0.44 1</ambient><diffuse>0.46 0.48 0.50 1</diffuse></material>
        </visual>
        <collision name='floor_3_collision'>
          <pose>0 0 4.70 0 0 0</pose><geometry><box><size>20 14 0.20</size></box></geometry>
          <surface><friction><ode><mu>20</mu><mu2>20</mu2></ode></friction></surface>
        </collision>
        <visual name='floor_3_visual'>
          <pose>0 0 4.70 0 0 0</pose><geometry><box><size>20 14 0.20</size></box></geometry>
          <material><ambient>0.45 0.47 0.49 1</ambient><diffuse>0.51 0.53 0.55 1</diffuse></material>
        </visual>
      </link>

      <!-- East vehicle route: one ramp and two turn landings for each level change. -->
      <link name='ramps_and_landings'>
        <collision name='ramp_12_collision'>
          <pose>11.9 0 1.1412 0 -0.197396 1.570796</pose>
          <geometry><box><size>12.237648 3.8 0.12</size></box></geometry>
          <surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface>
        </collision>
        <visual name='ramp_12_visual'>
          <pose>11.9 0 1.1412 0 -0.197396 1.570796</pose>
          <geometry><box><size>12.237648 3.8 0.12</size></box></geometry>
          <material><ambient>0.30 0.33 0.35 1</ambient><diffuse>0.35 0.38 0.40 1</diffuse></material>
        </visual>
        <collision name='ramp_23_collision'>
          <pose>11.9 0 3.5412 0 -0.197396 1.570796</pose>
          <geometry><box><size>12.237648 3.8 0.12</size></box></geometry>
          <surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface>
        </collision>
        <visual name='ramp_23_visual'>
          <pose>11.9 0 3.5412 0 -0.197396 1.570796</pose>
          <geometry><box><size>12.237648 3.8 0.12</size></box></geometry>
          <material><ambient>0.30 0.33 0.35 1</ambient><diffuse>0.35 0.38 0.40 1</diffuse></material>
        </visual>

        <collision name='ramp_12_lower_landing_collision'><pose>11.9 -6.5 -0.06 0 0 0</pose><geometry><box><size>3.8 1.0 0.12</size></box></geometry></collision>
        <visual name='ramp_12_lower_landing_visual'><pose>11.9 -6.5 -0.06 0 0 0</pose><geometry><box><size>3.8 1.0 0.12</size></box></geometry><material><ambient>0.30 0.33 0.35 1</ambient><diffuse>0.35 0.38 0.40 1</diffuse></material></visual>
        <collision name='ramp_12_upper_landing_collision'><pose>11.9 6.5 2.34 0 0 0</pose><geometry><box><size>3.8 1.0 0.12</size></box></geometry></collision>
        <visual name='ramp_12_upper_landing_visual'><pose>11.9 6.5 2.34 0 0 0</pose><geometry><box><size>3.8 1.0 0.12</size></box></geometry><material><ambient>0.30 0.33 0.35 1</ambient><diffuse>0.35 0.38 0.40 1</diffuse></material></visual>
        <collision name='ramp_23_lower_landing_collision'><pose>11.9 -6.5 2.34 0 0 0</pose><geometry><box><size>3.8 1.0 0.12</size></box></geometry></collision>
        <visual name='ramp_23_lower_landing_visual'><pose>11.9 -6.5 2.34 0 0 0</pose><geometry><box><size>3.8 1.0 0.12</size></box></geometry><material><ambient>0.30 0.33 0.35 1</ambient><diffuse>0.35 0.38 0.40 1</diffuse></material></visual>
        <collision name='ramp_23_upper_landing_collision'><pose>11.9 6.5 4.74 0 0 0</pose><geometry><box><size>3.8 1.0 0.12</size></box></geometry></collision>
        <visual name='ramp_23_upper_landing_visual'><pose>11.9 6.5 4.74 0 0 0</pose><geometry><box><size>3.8 1.0 0.12</size></box></geometry><material><ambient>0.30 0.33 0.35 1</ambient><diffuse>0.35 0.38 0.40 1</diffuse></material></visual>
      </link>

      <!-- West pedestrian/robot route landings; the 30-step flights are below. -->
      <link name='stair_landings'>
        <collision name='stair_12_lower_landing_collision'><pose>-11.1 -4.5 -0.06 0 0 0</pose><geometry><box><size>2.2 1.0 0.12</size></box></geometry></collision>
        <visual name='stair_12_lower_landing_visual'><pose>-11.1 -4.5 -0.06 0 0 0</pose><geometry><box><size>2.2 1.0 0.12</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_12_upper_landing_collision'><pose>-11.1 4.5 2.34 0 0 0</pose><geometry><box><size>2.2 1.0 0.12</size></box></geometry></collision>
        <visual name='stair_12_upper_landing_visual'><pose>-11.1 4.5 2.34 0 0 0</pose><geometry><box><size>2.2 1.0 0.12</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <!-- The upper flight is offset farther west so it cannot reduce headroom above the lower flight. -->
        <collision name='stair_23_lower_landing_collision'><pose>-12.55 -4.5 2.34 0 0 0</pose><geometry><box><size>5.1 1.0 0.12</size></box></geometry></collision>
        <visual name='stair_23_lower_landing_visual'><pose>-12.55 -4.5 2.34 0 0 0</pose><geometry><box><size>5.1 1.0 0.12</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_23_upper_landing_collision'><pose>-12.55 4.5 4.74 0 0 0</pose><geometry><box><size>5.1 1.0 0.12</size></box></geometry></collision>
        <visual name='stair_23_upper_landing_visual'><pose>-12.55 4.5 4.74 0 0 0</pose><geometry><box><size>5.1 1.0 0.12</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
      </link>

      <!-- Stair geometry: 30 shallow steps per floor change. -->
      <link name='stairs'>
        <!-- Level 1 to level 2: 30 steps, 0.267 m tread x 0.08 m rise. -->
        <collision name='stair_12_step_01_collision'><pose>-11.1 -3.866667 0.040 0 0 0</pose><geometry><box><size>2.2 0.266668 0.080</size></box></geometry><surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface></collision>
        <visual name='stair_12_step_01_visual'><pose>-11.1 -3.866667 0.040 0 0 0</pose><geometry><box><size>2.2 0.266668 0.080</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_12_step_02_collision'><pose>-11.1 -3.600000 0.080 0 0 0</pose><geometry><box><size>2.2 0.266668 0.160</size></box></geometry><surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface></collision>
        <visual name='stair_12_step_02_visual'><pose>-11.1 -3.600000 0.080 0 0 0</pose><geometry><box><size>2.2 0.266668 0.160</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_12_step_03_collision'><pose>-11.1 -3.333333 0.120 0 0 0</pose><geometry><box><size>2.2 0.266668 0.240</size></box></geometry><surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface></collision>
        <visual name='stair_12_step_03_visual'><pose>-11.1 -3.333333 0.120 0 0 0</pose><geometry><box><size>2.2 0.266668 0.240</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_12_step_04_collision'><pose>-11.1 -3.066667 0.160 0 0 0</pose><geometry><box><size>2.2 0.266668 0.320</size></box></geometry><surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface></collision>
        <visual name='stair_12_step_04_visual'><pose>-11.1 -3.066667 0.160 0 0 0</pose><geometry><box><size>2.2 0.266668 0.320</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_12_step_05_collision'><pose>-11.1 -2.800000 0.200 0 0 0</pose><geometry><box><size>2.2 0.266668 0.400</size></box></geometry><surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface></collision>
        <visual name='stair_12_step_05_visual'><pose>-11.1 -2.800000 0.200 0 0 0</pose><geometry><box><size>2.2 0.266668 0.400</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_12_step_06_collision'><pose>-11.1 -2.533333 0.240 0 0 0</pose><geometry><box><size>2.2 0.266668 0.480</size></box></geometry><surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface></collision>
        <visual name='stair_12_step_06_visual'><pose>-11.1 -2.533333 0.240 0 0 0</pose><geometry><box><size>2.2 0.266668 0.480</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_12_step_07_collision'><pose>-11.1 -2.266667 0.280 0 0 0</pose><geometry><box><size>2.2 0.266668 0.560</size></box></geometry><surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface></collision>
        <visual name='stair_12_step_07_visual'><pose>-11.1 -2.266667 0.280 0 0 0</pose><geometry><box><size>2.2 0.266668 0.560</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_12_step_08_collision'><pose>-11.1 -2.000000 0.320 0 0 0</pose><geometry><box><size>2.2 0.266668 0.640</size></box></geometry><surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface></collision>
        <visual name='stair_12_step_08_visual'><pose>-11.1 -2.000000 0.320 0 0 0</pose><geometry><box><size>2.2 0.266668 0.640</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_12_step_09_collision'><pose>-11.1 -1.733333 0.360 0 0 0</pose><geometry><box><size>2.2 0.266668 0.720</size></box></geometry><surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface></collision>
        <visual name='stair_12_step_09_visual'><pose>-11.1 -1.733333 0.360 0 0 0</pose><geometry><box><size>2.2 0.266668 0.720</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_12_step_10_collision'><pose>-11.1 -1.466667 0.400 0 0 0</pose><geometry><box><size>2.2 0.266668 0.800</size></box></geometry><surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface></collision>
        <visual name='stair_12_step_10_visual'><pose>-11.1 -1.466667 0.400 0 0 0</pose><geometry><box><size>2.2 0.266668 0.800</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_12_step_11_collision'><pose>-11.1 -1.200000 0.440 0 0 0</pose><geometry><box><size>2.2 0.266668 0.880</size></box></geometry><surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface></collision>
        <visual name='stair_12_step_11_visual'><pose>-11.1 -1.200000 0.440 0 0 0</pose><geometry><box><size>2.2 0.266668 0.880</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_12_step_12_collision'><pose>-11.1 -0.933333 0.480 0 0 0</pose><geometry><box><size>2.2 0.266668 0.960</size></box></geometry><surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface></collision>
        <visual name='stair_12_step_12_visual'><pose>-11.1 -0.933333 0.480 0 0 0</pose><geometry><box><size>2.2 0.266668 0.960</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_12_step_13_collision'><pose>-11.1 -0.666667 0.520 0 0 0</pose><geometry><box><size>2.2 0.266668 1.040</size></box></geometry><surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface></collision>
        <visual name='stair_12_step_13_visual'><pose>-11.1 -0.666667 0.520 0 0 0</pose><geometry><box><size>2.2 0.266668 1.040</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_12_step_14_collision'><pose>-11.1 -0.400000 0.560 0 0 0</pose><geometry><box><size>2.2 0.266668 1.120</size></box></geometry><surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface></collision>
        <visual name='stair_12_step_14_visual'><pose>-11.1 -0.400000 0.560 0 0 0</pose><geometry><box><size>2.2 0.266668 1.120</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_12_step_15_collision'><pose>-11.1 -0.133333 0.600 0 0 0</pose><geometry><box><size>2.2 0.266668 1.200</size></box></geometry><surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface></collision>
        <visual name='stair_12_step_15_visual'><pose>-11.1 -0.133333 0.600 0 0 0</pose><geometry><box><size>2.2 0.266668 1.200</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_12_step_16_collision'><pose>-11.1 0.133333 0.640 0 0 0</pose><geometry><box><size>2.2 0.266668 1.280</size></box></geometry><surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface></collision>
        <visual name='stair_12_step_16_visual'><pose>-11.1 0.133333 0.640 0 0 0</pose><geometry><box><size>2.2 0.266668 1.280</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_12_step_17_collision'><pose>-11.1 0.400000 0.680 0 0 0</pose><geometry><box><size>2.2 0.266668 1.360</size></box></geometry><surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface></collision>
        <visual name='stair_12_step_17_visual'><pose>-11.1 0.400000 0.680 0 0 0</pose><geometry><box><size>2.2 0.266668 1.360</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_12_step_18_collision'><pose>-11.1 0.666667 0.720 0 0 0</pose><geometry><box><size>2.2 0.266668 1.440</size></box></geometry><surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface></collision>
        <visual name='stair_12_step_18_visual'><pose>-11.1 0.666667 0.720 0 0 0</pose><geometry><box><size>2.2 0.266668 1.440</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_12_step_19_collision'><pose>-11.1 0.933333 0.760 0 0 0</pose><geometry><box><size>2.2 0.266668 1.520</size></box></geometry><surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface></collision>
        <visual name='stair_12_step_19_visual'><pose>-11.1 0.933333 0.760 0 0 0</pose><geometry><box><size>2.2 0.266668 1.520</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
        <collision name='stair_12_step_20_collision'><pose>-11.1 1.200000 0.800 0 0 0</pose><geometry><box><size>2.2 0.266668 1.600</size></box></geometry><surface><friction><ode><mu>30</mu><mu2>30</mu2></ode></friction></surface></collision>
        <visual name='stair_12_step_20_visual'><pose>-11.1 1.200000 0.800 0 0 0</pose><geometry><box><size>2.2 0.266668 1.600</size></box></geometry><material><ambient>0.54 0.51 0.43 1</ambient><diffuse>0.62 0.58 0.48 1</diffuse></material></visual>
